<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System bar colors and icon contrast are handled by enableEdgeToEdge() in MainActivity. -->
    <style name="Theme.UniDo" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Shown while the app starts; switches to Theme.UniDo after installSplashScreen(). -->
    <style name="Theme.UniDo.Starting" parent="Theme.SplashScreen">
        <!-- The logo is black, so the splash stays white in the dark theme too. -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.UniDo</item>
    </style>
</resources>
